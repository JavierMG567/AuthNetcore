{
  "openapi": "3.0.1",
  "info": {
    "title": "NethAuthCoreValue Microservice",
    "description": "Manager Accounts via endpoints to set the real constrictions",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/Account/CustomerRegistration": {
      "post": {
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountRegistration"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountRegistration"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AccountRegistration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/Account/CustomerLoginAcces": {
      "post": {
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountLogin"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountLogin"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AccountLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/Account/CustomerDeleteAcces": {
      "delete": {
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "tokenString",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/Account/CustomerLogoutAcces": {
      "post": {
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "tokenString",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLogin": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AccountRegistration": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "confirmPassword": {
            "type": "string",
            "nullable": true
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  }
}